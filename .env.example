# Client: public URL of the Socket.IO server. Defaults to http://localhost:3001.
VITE_MULTIPLAYER_SERVER_URL=http://localhost:3001
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server: listening port and permitted browser origin(s), comma-separated.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Server only. Required when NODE_ENV=production; never expose this in Vite.
# Local development verifies Auth with SUPABASE_URL but keeps rooms in memory.
# Set this to true only for an intentional non-production persistence environment.
SUPABASE_ROOM_PERSISTENCE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-side-secret-key
